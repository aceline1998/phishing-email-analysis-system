# ============================================================
# 钓鱼邮件智能分析系统 - 环境变量配置示例
# 使用说明：复制本文件为 .env，并按实际情况修改。
# 未设置的环境变量将使用代码内置默认值（保证向后兼容）。
# ============================================================

# ---------- MySQL 数据库配置 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=phishing
MYSQL_PASSWORD=请修改为你的数据库密码
MYSQL_DATABASE=phishing_agent
MYSQL_CHARSET=utf8mb4

# ---------- Redis 配置 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# 如 Redis 未设置密码，请留空（脚本会将其转换为无密码连接）
REDIS_PASSWORD=请修改为你的Redis密码
REDIS_DB=0
